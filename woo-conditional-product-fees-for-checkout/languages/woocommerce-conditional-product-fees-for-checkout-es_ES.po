#: includes/class-wcpfc-fee-suggestion-engine.php:498
msgid "%1$s category orders/month × %2$s%% avg fee on ~%3$s AOV ≈ %4$s/month"
msgstr ""
"%1$s categoría de pedidos al mes × %2$s%% tarifa promedio de ~%3$s AOV ≈ "
"%4$s/mes"

#. translators: 1: condition label, 2: value
